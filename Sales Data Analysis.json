    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Calculer le total des ventes\ntotal_sales = 0\n\nfor item in _items:\n    total_sales += float(item[\"json\"][\"SALES\"])\n\n# Retourner le résultat\nreturn [{\n    \"json\": {\n        \"total_sales\": total_sales,\n        \"rows_analyzed\": len(_items)\n    }\n}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        192
      ],
      "id": "66da3d96-f3c2-4362-8dbb-a4366df0d5e4",
      "name": "Total sales"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Initialiser un dictionnaire pour stocker les ventes par produit\nsales_by_product = {}\n\n# Parcourir toutes les lignes du fichier\nfor item in _items:\n    product = item[\"json\"][\"PRODUCTLINE\"]\n    sales = float(item[\"json\"][\"SALES\"])\n\n    # Additionner les ventes de chaque catégorie\n    if product in sales_by_product:\n        sales_by_product[product] += sales\n    else:\n        sales_by_product[product] = sales\n\n# Trier les produits du plus vendu au moins vendu\nresults = sorted(\n    sales_by_product.items(),\n    key=lambda x: x[1],\n    reverse=True\n)\n\n# Retourner les résultats\nreturn [\n    {\n        \"json\": {\n            \"product_line\": product,\n            \"total_sales\": round(total, 2)\n        }\n    }\n    for product, total in results\n]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        336
      ],
      "id": "b73679e1-d906-4ce2-8997-9af2f311a109",
      "name": "Sales by Product Line"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "\n# Initialiser un dictionnaire pour les ventes par pays\nsales_by_country = {}\n\n# Parcourir toutes les lignes\nfor item in _items:\n    country = item[\"json\"][\"COUNTRY\"]\n    sales = float(item[\"json\"][\"SALES\"])\n\n    # Calculer le total des ventes par pays\n    if country in sales_by_country:\n        sales_by_country[country] += sales\n    else:\n        sales_by_country[country] = sales\n\n# Trier les pays du plus vendu au moins vendu\nresults = sorted(\n    sales_by_country.items(),\n    key=lambda x: x[1],\n    reverse=True\n)\n\n# Retourner les résultats\nreturn [\n    {\n        \"json\": {\n            \"country\": country,\n            \"total_sales\": round(total, 2)\n        }\n    }\n    for country, total in results\n]\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        480
      ],
      "id": "18c77be7-e30c-4926-bb71-5cd5d31c9457",
      "name": "Sales by Country"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "\nmonthly_sales = {}\n\nfor item in _items:\n    year = int(item[\"json\"][\"YEAR_ID\"])\n    month = int(item[\"json\"][\"MONTH_ID\"])\n    sales = float(item[\"json\"][\"SALES\"])\n\n    period = f\"{year}-{month:02d}\"\n\n    if period in monthly_sales:\n        monthly_sales[period] += sales\n    else:\n        monthly_sales[period] = sales\n\nresults = sorted(monthly_sales.items())\n\nreturn [\n    {\n        \"json\": {\n            \"month\": period,\n            \"total_sales\": round(total, 2)\n        }\n    }\n    for period, total in results\n]\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        656
      ],
      "id": "3e421ced-40e2-4b96-8fd8-ffcb451012e3",
      "name": "Monthly Sales"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "\ncustomer_sales = {}\n\nfor item in _items:\n    customer = item[\"json\"][\"CUSTOMERNAME\"]\n    sales = float(item[\"json\"][\"SALES\"])\n\n    if customer in customer_sales:\n        customer_sales[customer] += sales\n    else:\n        customer_sales[customer] = sales\n\nresults = sorted(\n    customer_sales.items(),\n    key=lambda x: x[1],\n    reverse=True\n)\n\nreturn [\n    {\n        \"json\": {\n            \"customer\": customer,\n            \"total_sales\": round(total, 2)\n        }\n    }\n    for customer, total in results[:10]\n]\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        832
      ],
      "id": "d04ad243-0dd5-48c9-a44a-8496cfff5d2b",
      "name": "Top 10 Customers"
    }
